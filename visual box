local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Camera = workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer

local StickyHitboxes = {}

local ENABLED = true
local RUNNING = true
local MAX_DISTANCE = 20
local MAX_MATCH_DISTANCE = 10

local latched = {}
local seen = {}
local lastFolderState = nil

local function getXYZ(value)
    if value == nil then
        return nil, nil, nil
    end

    local ok, x, y, z = pcall(function()
        return value.X, value.Y, value.Z
    end)

    if not ok then
        return nil, nil, nil
    end

    if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then
        return nil, nil, nil
    end

    return x, y, z
end

local function safeDistance(a, b)
    local ax, ay, az = getXYZ(a)
    local bx, by, bz = getXYZ(b)

    if ax == nil or bx == nil then
        return nil
    end

    local dx = ax - bx
    local dy = ay - by
    local dz = az - bz

    return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function safeMagnitude(value)
    local x, y, z = getXYZ(value)

    if x == nil then
        return nil
    end

    return math.sqrt(x * x + y * y + z * z)
end

local function safePosition(object)
    if object == nil then
        return nil
    end

    local ok, value = pcall(function()
        return object.Position
    end)

    if not ok then
        return nil
    end

    local x = getXYZ(value)

    if x == nil then
        return nil
    end

    return value
end

local function getCharacterData(player)
    if player == nil then
        return nil, nil, nil
    end

    local character = player.Character
    if character == nil then
        return nil, nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if humanoid == nil or root == nil then
        return nil, nil, nil
    end

    if humanoid.Health <= 0 then
        return nil, nil, nil
    end

    return character, humanoid, root
end

local function getBodyAnchor(character, root)
    local part = character:FindFirstChild("UpperTorso")

    if part == nil then
        part = character:FindFirstChild("Torso")
    end

    if part == nil then
        part = root
    end

    return part
end

local function getLocalRoot()
    local character = LocalPlayer.Character

    if character == nil then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function makeBox()
    local box = Drawing.new("Square")
    box.Filled = false
    box.Thickness = 3
    box.Transparency = 1
    box.Color = Color3.fromRGB(255, 40, 40)
    box.Visible = false
    box.ZIndex = 50

    return box
end

local function makeLabel()
    local label = Drawing.new("Text")
    label.Size = 16
    label.Center = true
    label.Outline = true
    label.Transparency = 1
    label.Color = Color3.fromRGB(255, 255, 255)
    label.Visible = false
    label.ZIndex = 51

    return label
end

local function destroyLatch(player)
    local data = latched[player]

    if data == nil then
        return
    end

    if data.Box ~= nil then
        pcall(function()
            data.Box:Remove()
        end)
    end

    if data.Label ~= nil then
        pcall(function()
            data.Label:Remove()
        end)
    end

    latched[player] = nil
end

local function clearAll()
    local list = {}

    for player, _ in pairs(latched) do
        list[#list + 1] = player
    end

    local i = 1

    while i <= #list do
        destroyLatch(list[i])
        i = i + 1
    end

    print("[StickyHitboxes V11] Cleared")
end

local function nearestBodyPartDistance(character, hitboxPosition)
    if getXYZ(hitboxPosition) == nil then
        return math.huge, nil
    end

    local children = character:GetChildren()
    local bestDistance = math.huge
    local bestPart = nil

    local i = 1

    while i <= #children do
        local child = children[i]

        if child:IsA("BasePart") then
            local childPosition = safePosition(child)

            if childPosition ~= nil then
                local distance = safeDistance(
                    childPosition,
                    hitboxPosition
                )

                if distance ~= nil and distance < bestDistance then
                    bestDistance = distance
                    bestPart = child
                end
            end
        end

        i = i + 1
    end

    return bestDistance, bestPart
end

local function findOwnerPlayer(hitbox)
    local owner = hitbox:FindFirstChild("Owner")

    if owner == nil then
        return nil, nil
    end

    if owner.ClassName ~= "StringValue" then
        return nil, nil
    end

    if owner.Value == nil or owner.Value == "" then
        return nil, nil
    end

    local players = Players:GetPlayers()
    local i = 1

    while i <= #players do
        local player = players[i]

        if player ~= LocalPlayer then
            if player.Name == owner.Value or player.DisplayName == owner.Value then
                local character, humanoid, root = getCharacterData(player)

                if character ~= nil and humanoid ~= nil and root ~= nil then
                    local hitboxPosition = safePosition(hitbox)

                    local _, part = nearestBodyPartDistance(
                        character,
                        hitboxPosition
                    )

                    return player, part
                end
            end
        end

        i = i + 1
    end

    return nil, nil
end

local function findTarget(hitbox)
    local ownerPlayer, ownerPart = findOwnerPlayer(hitbox)

    if ownerPlayer ~= nil then
        print(
            "[StickyHitboxes V11] Matched Owner -> "
            .. tostring(ownerPlayer.Name)
        )

        return ownerPlayer, ownerPart
    end

    local localRoot = getLocalRoot()

    if localRoot == nil then
        return nil, nil
    end

    local players = Players:GetPlayers()

    local bestPlayer = nil
    local bestPart = nil
    local bestDistance = math.huge

    local i = 1

    while i <= #players do
        local player = players[i]

        if player ~= LocalPlayer then
            local character, humanoid, root = getCharacterData(player)

            if character ~= nil and humanoid ~= nil and root ~= nil then
                local rootPosition = safePosition(root)
                local localPosition = safePosition(localRoot)
                local localDistance = safeDistance(
                    rootPosition,
                    localPosition
                )

                if localDistance == nil then
                    localDistance = math.huge
                end

                if localDistance <= MAX_DISTANCE then
                    local hitboxPosition = safePosition(hitbox)

                    local bodyDistance, bodyPart =
                        nearestBodyPartDistance(
                            character,
                            hitboxPosition
                        )

                    if bodyDistance < bestDistance then
                        bestDistance = bodyDistance
                        bestPlayer = player
                        bestPart = bodyPart
                    end
                end
            end
        end

        i = i + 1
    end

    if bestPlayer == nil then
        return nil, nil
    end

    local hitboxMagnitude = safeMagnitude(hitbox.Size)

    if hitboxMagnitude == nil then
        hitboxMagnitude = 4
    end

    local allowedDistance =
        MAX_MATCH_DISTANCE + (hitboxMagnitude * 0.5)

    if bestDistance > allowedDistance then
        print(
            "[StickyHitboxes V11] Closest target too far from hitbox: "
            .. tostring(math.floor(bestDistance * 100) / 100)
        )

        return nil, nil
    end

    print(
        "[StickyHitboxes V11] Matched -> "
        .. tostring(bestPlayer.Name)
        .. " | distance="
        .. tostring(math.floor(bestDistance * 100) / 100)
    )

    return bestPlayer, bestPart
end

local function latchPlayer(player, hitbox, matchedPart)
    local character, humanoid, root = getCharacterData(player)

    if character == nil or humanoid == nil or root == nil then
        return
    end

    -- One box per player: newest hitbox completely replaces the previous one.
    destroyLatch(player)

    local anchor = matchedPart

    if anchor == nil or anchor.Parent ~= character then
        anchor = getBodyAnchor(character, root)
    end

    if anchor == nil then
        return
    end

    local hitboxSize = hitbox.Size

    if getXYZ(hitboxSize) == nil then
        print("[StickyHitboxes V11] Invalid hitbox size; skipping latch")
        return
    end

    latched[player] = {
        HitboxSize = hitboxSize,
        AnchorPartName = anchor.Name,
        Box = makeBox(),
        Label = makeLabel()
    }

    print(
        "[StickyHitboxes V11] LATCHED -> "
        .. tostring(player.Name)
        .. " | anchor="
        .. tostring(anchor.Name)
        .. " | size="
        .. tostring(hitbox.Size)
    )
end

local function hideLatch(data)
    if data.Box ~= nil then
        data.Box.Visible = false
    end

    if data.Label ~= nil then
        data.Label.Visible = false
    end
end

local function updateLatch(player, data)
    local character, humanoid, root = getCharacterData(player)

    if character == nil or humanoid == nil or root == nil then
        destroyLatch(player)
        return
    end

    local anchor = character:FindFirstChild(data.AnchorPartName)

    if anchor == nil or not anchor:IsA("BasePart") then
        anchor = getBodyAnchor(character, root)

        if anchor == nil then
            destroyLatch(player)
            return
        end

        data.AnchorPartName = anchor.Name
    end

    local anchorPosition = safePosition(anchor)

    if anchorPosition == nil then
        hideLatch(data)
        return
    end

    local screenPosition, onScreen =
        WorldToScreen(anchorPosition)

    if screenPosition == nil or onScreen ~= true then
        hideLatch(data)
        return
    end

    local distance = 10

    if Camera ~= nil and Camera.CFrame ~= nil then
        local cameraPosition = Camera.CFrame.Position

        if cameraPosition ~= nil then
            local measured = safeDistance(
                cameraPosition,
                anchorPosition
            )

            if measured ~= nil then
                distance = measured
            end
        end
    else
        local localRoot = getLocalRoot()

        if localRoot ~= nil then
            local measured = safeDistance(
                safePosition(localRoot),
                anchorPosition
            )

            if measured ~= nil then
                distance = measured
            end
        end
    end

    if distance < 1 then
        distance = 1
    end

    local sizeMagnitude = safeMagnitude(data.HitboxSize)

    if sizeMagnitude == nil then
        hideLatch(data)
        return
    end

    local pixelSize =
        (sizeMagnitude * 115) / distance

    if pixelSize < 24 then
        pixelSize = 24
    end

    if pixelSize > 220 then
        pixelSize = 220
    end

    local width = pixelSize
    local height = pixelSize

    -- Roblox avatars are vertically taller than a typical hitbox.
    if data.HitboxSize.Y >= data.HitboxSize.X then
        height = pixelSize * 1.15
    end

    local x = screenPosition.X - width * 0.5
    local y = screenPosition.Y - height * 0.5

    data.Box.Position = Vector2.new(x, y)
    data.Box.Size = Vector2.new(width, height)
    data.Box.Visible = true

    data.Label.Position =
        Vector2.new(
            screenPosition.X,
            y - 18
        )

    data.Label.Text =
        tostring(player.DisplayName)
        .. " [HITBOX LOCKED]"

    data.Label.Visible = true
end

local function cleanup()
    local stale = {}

    for player, _ in pairs(latched) do
        local character, humanoid, root =
            getCharacterData(player)

        if player.Parent ~= Players then
            stale[#stale + 1] = player
        elseif character == nil
            or humanoid == nil
            or root == nil then

            stale[#stale + 1] = player
        end
    end

    local i = 1

    while i <= #stale do
        destroyLatch(stale[i])
        i = i + 1
    end
end

local function processHitboxes()
    local folder =
        Workspace:FindFirstChild("Hitboxes")

    if folder == nil then
        if lastFolderState ~= false then
            print(
                "[StickyHitboxes V11] workspace.Hitboxes NOT FOUND"
            )

            lastFolderState = false
        end

        return
    end

    if lastFolderState ~= true then
        print(
            "[StickyHitboxes V11] workspace.Hitboxes FOUND"
        )

        lastFolderState = true
    end

    local children = folder:GetChildren()
    local current = {}

    local i = 1

    while i <= #children do
        local hitbox = children[i]

        if hitbox:IsA("BasePart") then
            local key = hitbox.Address

            if key == nil then
                key = tostring(hitbox)
            end

            current[key] = true

            if seen[key] == nil then
                seen[key] = true

                local target, part =
                    findTarget(hitbox)

                if target ~= nil then
                    latchPlayer(
                        target,
                        hitbox,
                        part
                    )
                end
            end
        end

        i = i + 1
    end

    local staleSeen = {}

    for key, _ in pairs(seen) do
        if current[key] == nil then
            staleSeen[#staleSeen + 1] = key
        end
    end

    i = 1

    while i <= #staleSeen do
        seen[staleSeen[i]] = nil
        i = i + 1
    end
end

task.spawn(function()
    while RUNNING do
        task.wait()

        if ENABLED then
            local ok, err = pcall(function()
                cleanup()
                processHitboxes()

                local players = {}

                for player, _ in pairs(latched) do
                    players[#players + 1] =
                        player
                end

                local i = 1

                while i <= #players do
                    local player = players[i]
                    local data = latched[player]

                    if data ~= nil then
                        updateLatch(
                            player,
                            data
                        )
                    end

                    i = i + 1
                end
            end)

            if not ok then
                warn(
                    "[StickyHitboxes V11] "
                    .. tostring(err)
                )
            end
        end
    end
end)

function StickyHitboxes.SetEnabled(value)
    ENABLED = value == true

    if ENABLED == false then
        clearAll()
    end
end

function StickyHitboxes.IsEnabled()
    return ENABLED
end

function StickyHitboxes.SetDetectionDistance(value)
    local newDistance = tonumber(value)

    if newDistance ~= nil
        and newDistance > 0 then

        MAX_DISTANCE = newDistance
    end
end

function StickyHitboxes.SetMatchDistance(value)
    local newDistance = tonumber(value)

    if newDistance ~= nil
        and newDistance > 0 then

        MAX_MATCH_DISTANCE =
            newDistance
    end
end

function StickyHitboxes.Clear()
    clearAll()
end

function StickyHitboxes.GetLatchedCount()
    local count = 0

    for _, _ in pairs(latched) do
        count = count + 1
    end

    return count
end

function StickyHitboxes.Destroy()
    ENABLED = false
    RUNNING = false
    clearAll()
end

print("[StickyHitboxes V11] SAFE-VECTOR BODY-LOCK BUILD LOADED")
print("[StickyHitboxes V11] Vector math uses guarded XYZ components")
print("[StickyHitboxes V11] One newest box per player")

return StickyHitboxes
