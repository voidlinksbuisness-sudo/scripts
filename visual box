local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

local StickyHitboxes = {}

local ENABLED = true
local RUNNING = true
local MAX_DISTANCE = 20
local CLEAR_KEY = Enum.KeyCode.P
local TARGET_PADDING = 3
local IGNORE_LOCAL_PLAYER = true

local CORNERS = {
    Vector3.new(-1, -1, -1),
    Vector3.new(1, -1, -1),
    Vector3.new(1, 1, -1),
    Vector3.new(-1, 1, -1),
    Vector3.new(-1, -1, 1),
    Vector3.new(1, -1, 1),
    Vector3.new(1, 1, 1),
    Vector3.new(-1, 1, 1)
}

local EDGES = {
    {1, 2},
    {2, 3},
    {3, 4},
    {4, 1},
    {5, 6},
    {6, 7},
    {7, 8},
    {8, 5},
    {1, 5},
    {2, 6},
    {3, 7},
    {4, 8}
}

local latched = {}
local seen = {}
local pWasDown = false
local keyPollingSupported = true
local DEBUG = true
local lastFolderState = nil
local lastCandidatePrint = 0
local lastNoTargetPrint = 0

local function getCharacterData(player)
    if player == nil then
        return nil, nil, nil
    end

    local character = player.Character
    if character == nil then
        return nil, nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if humanoid == nil or root == nil then
        return nil, nil, nil
    end

    if humanoid.Health <= 0 then
        return nil, nil, nil
    end

    return character, humanoid, root
end

local function getLocalRoot()
    local character = LocalPlayer.Character
    if character == nil then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function makeLine()
    local line = Drawing.new("Line")
    line.Thickness = 2
    line.Transparency = 1
    line.Color = Color3.fromRGB(255, 70, 70)
    line.Visible = false
    line.ZIndex = 10
    return line
end

local function makeLabel()
    local label = Drawing.new("Text")
    label.Size = 15
    label.Center = true
    label.Outline = true
    label.Transparency = 1
    label.Color = Color3.fromRGB(255, 255, 255)
    label.Visible = false
    label.ZIndex = 11
    return label
end

local function hideLatch(data)
    if data == nil then
        return
    end

    local i = 1
    while i <= #data.Lines do
        data.Lines[i].Visible = false
        i = i + 1
    end

    if data.Label ~= nil then
        data.Label.Visible = false
    end
end

local function destroyLatch(player)
    local data = latched[player]
    if data == nil then
        return
    end

    local i = 1
    while i <= #data.Lines do
        local line = data.Lines[i]
        pcall(function()
            line:Remove()
        end)
        i = i + 1
    end

    if data.Label ~= nil then
        pcall(function()
            data.Label:Remove()
        end)
    end

    latched[player] = nil
end

local function clearAll()
    local list = {}

    for player, _ in pairs(latched) do
        list[#list + 1] = player
    end

    local i = 1
    while i <= #list do
        destroyLatch(list[i])
        i = i + 1
    end

    print("[StickyHitboxes] Cleared")
end

local function distancePointToBox(point, boxPosition, boxSize)
    local half = boxSize * 0.5
    local delta = point - boxPosition

    local dx = math.abs(delta.X) - half.X
    local dy = math.abs(delta.Y) - half.Y
    local dz = math.abs(delta.Z) - half.Z

    if dx < 0 then dx = 0 end
    if dy < 0 then dy = 0 end
    if dz < 0 then dz = 0 end

    return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function findTarget(hitbox)
    local localRoot = getLocalRoot()
    if localRoot == nil then
        return nil
    end

    local players = Players:GetPlayers()
    local bestPlayer = nil
    local bestScore = math.huge

    local i = 1
    while i <= #players do
        local player = players[i]

        if not (IGNORE_LOCAL_PLAYER and player == LocalPlayer) then
            local character, humanoid, root = getCharacterData(player)

            if character ~= nil and humanoid ~= nil and root ~= nil then
                local localDistance = (root.Position - localRoot.Position).Magnitude

                if localDistance <= MAX_DISTANCE then
                    local outsideDistance = distancePointToBox(
                        root.Position,
                        hitbox.Position,
                        hitbox.Size
                    )

                    if outsideDistance <= TARGET_PADDING then
                        local centerDistance = (root.Position - hitbox.Position).Magnitude
                        local score = outsideDistance * 10 + centerDistance

                        if score < bestScore then
                            bestScore = score
                            bestPlayer = player
                        end
                    end
                end
            end
        end

        i = i + 1
    end

    return bestPlayer
end

local function latchPlayer(player, hitbox)
    local character, humanoid, root = getCharacterData(player)

    if character == nil or humanoid == nil or root == nil then
        return
    end

    local existing = latched[player]

    if existing ~= nil then
        existing.Size = hitbox.Size
        existing.Offset = hitbox.Position - root.Position
        return
    end

    local lines = {}
    local i = 1

    while i <= 12 do
        lines[i] = makeLine()
        i = i + 1
    end

    latched[player] = {
        Size = hitbox.Size,
        Offset = hitbox.Position - root.Position,
        Lines = lines,
        Label = makeLabel()
    }

    print("[StickyHitboxes] Latched " .. tostring(player.Name))
end

local function getWorldCorners(center, size)
    local half = size * 0.5
    local result = {}

    local i = 1
    while i <= #CORNERS do
        local sign = CORNERS[i]

        result[i] = Vector3.new(
            center.X + sign.X * half.X,
            center.Y + sign.Y * half.Y,
            center.Z + sign.Z * half.Z
        )

        i = i + 1
    end

    return result
end

local function updateLatch(player, data)
    local character, humanoid, root = getCharacterData(player)

    if character == nil or humanoid == nil or root == nil then
        destroyLatch(player)
        return
    end

    local boxCenter = root.Position + data.Offset
    local worldCorners = getWorldCorners(boxCenter, data.Size)
    local screenCorners = {}
    local visibleCount = 0

    local i = 1
    while i <= #worldCorners do
        local screenPoint, onScreen = WorldToScreen(worldCorners[i])

        screenCorners[i] = {
            Position = screenPoint,
            Visible = onScreen == true
        }

        if screenPoint ~= nil and onScreen == true then
            visibleCount = visibleCount + 1
        end

        i = i + 1
    end

    if visibleCount < 2 then
        hideLatch(data)
        return
    end

    local anyLine = false
    i = 1

    while i <= #EDGES do
        local edge = EDGES[i]
        local a = screenCorners[edge[1]]
        local b = screenCorners[edge[2]]
        local line = data.Lines[i]

        local canDraw = false

        if a ~= nil and b ~= nil then
            if a.Position ~= nil and b.Position ~= nil then
                if a.Visible == true and b.Visible == true then
                    canDraw = true
                end
            end
        end

        if canDraw then
            line.From = a.Position
            line.To = b.Position
            line.Visible = true
            anyLine = true
        else
            line.Visible = false
        end

        i = i + 1
    end

    if anyLine then
        local topWorld = Vector3.new(
            boxCenter.X,
            boxCenter.Y + data.Size.Y * 0.5 + 0.6,
            boxCenter.Z
        )

        local topScreen, topVisible = WorldToScreen(topWorld)

        if topScreen ~= nil and topVisible == true then
            data.Label.Position = topScreen
            data.Label.Text = tostring(player.DisplayName) .. " [LOCKED]"
            data.Label.Visible = true
        else
            data.Label.Visible = false
        end
    else
        data.Label.Visible = false
    end
end

local function processHitboxes()
    local folder = Workspace:FindFirstChild("Hitboxes")

    if folder == nil then
        if DEBUG and lastFolderState ~= false then
            print("[StickyHitboxes] workspace.Hitboxes not found")
            lastFolderState = false
        end
        return
    end

    if DEBUG and lastFolderState ~= true then
        print("[StickyHitboxes] workspace.Hitboxes detected")
        lastFolderState = true
    end

    local children = folder:GetChildren()

    if DEBUG and #children > 0 then
        local now = os.clock()
        if now - lastCandidatePrint >= 1 then
            print("[StickyHitboxes] Temporary hitbox parts visible: " .. tostring(#children))
            lastCandidatePrint = now
        end
    end
    local current = {}

    local i = 1
    while i <= #children do
        local hitbox = children[i]

        if hitbox:IsA("BasePart") then
            local key = hitbox.Address

            if key == nil then
                key = tostring(hitbox)
            end

            current[key] = true

            if seen[key] == nil then
                seen[key] = true

                local target = findTarget(hitbox)

                if target ~= nil then
                    print(
                        "[StickyHitboxes] Detected hitbox -> "
                        .. tostring(target.Name)
                        .. " | size="
                        .. tostring(hitbox.Size)
                    )
                    latchPlayer(target, hitbox)
                else
                    if DEBUG then
                        local now = os.clock()
                        if now - lastNoTargetPrint >= 1 then
                            print(
                                "[StickyHitboxes] Saw hitbox but could not match it to a player within "
                                .. tostring(MAX_DISTANCE)
                                .. " studs"
                            )
                            lastNoTargetPrint = now
                        end
                    end
                end
            end
        end

        i = i + 1
    end

    local stale = {}

    for key, _ in pairs(seen) do
        if current[key] == nil then
            stale[#stale + 1] = key
        end
    end

    i = 1
    while i <= #stale do
        seen[stale[i]] = nil
        i = i + 1
    end
end

local function cleanupDeadPlayers()
    local stale = {}

    for player, _ in pairs(latched) do
        local character, humanoid, root = getCharacterData(player)

        if character == nil or humanoid == nil or root == nil then
            stale[#stale + 1] = player
        else
            if player.Parent ~= Players then
                stale[#stale + 1] = player
            end
        end
    end

    local i = 1
    while i <= #stale do
        destroyLatch(stale[i])
        i = i + 1
    end
end

local function updateClearKey()
    if keyPollingSupported == false then
        return
    end

    local ok, result = pcall(function()
        if type(UserInputService.IsKeyDown) ~= "function" then
            return false
        end

        return UserInputService:IsKeyDown(CLEAR_KEY)
    end)

    if not ok then
        keyPollingSupported = false
        warn("[StickyHitboxes] P key polling unsupported; use Clear Sticky Hitboxes on Main")
        return
    end

    local isDown = result == true

    if isDown and not pWasDown then
        clearAll()
    end

    pWasDown = isDown
end

task.spawn(function()
    while RUNNING do
        task.wait()

        if ENABLED then
            local ok, err = pcall(function()
                updateClearKey()
                cleanupDeadPlayers()
                processHitboxes()

                local players = {}

                for player, _ in pairs(latched) do
                    players[#players + 1] = player
                end

                local i = 1
                while i <= #players do
                    local player = players[i]
                    local data = latched[player]

                    if data ~= nil then
                        updateLatch(player, data)
                    end

                    i = i + 1
                end
            end)

            if not ok then
                warn("[StickyHitboxes] " .. tostring(err))
            end
        else
            pcall(updateClearKey)
        end
    end
end)

function StickyHitboxes.SetEnabled(value)
    ENABLED = value == true

    if ENABLED == false then
        clearAll()
    end
end

function StickyHitboxes.IsEnabled()
    return ENABLED
end

function StickyHitboxes.SetDetectionDistance(value)
    local numberValue = tonumber(value)

    if numberValue ~= nil and numberValue > 0 then
        MAX_DISTANCE = numberValue
    end
end

function StickyHitboxes.GetDetectionDistance()
    return MAX_DISTANCE
end

function StickyHitboxes.Clear()
    clearAll()
end

function StickyHitboxes.GetLatchedCount()
    local count = 0

    for _, _ in pairs(latched) do
        count = count + 1
    end

    return count
end

function StickyHitboxes.SetDebug(value)
    DEBUG = value == true
end

function StickyHitboxes.Destroy()
    ENABLED = false
    RUNNING = false
    clearAll()
end

print("[StickyHitboxes] Matcha-safe NO-CFRAME latch build loaded")
print("[StickyHitboxes] Detection range: " .. tostring(MAX_DISTANCE))
print("[StickyHitboxes] Press P to clear latched boxes")

return StickyHitboxes
