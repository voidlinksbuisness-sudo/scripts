local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local StickyHitboxes = {}

local ENABLED = true
local RUNNING = true
local MAX_DISTANCE = 20
local MAX_MATCH_DISTANCE = 10

local CORNERS = {
    Vector3.new(-1, -1, -1),
    Vector3.new(1, -1, -1),
    Vector3.new(1, 1, -1),
    Vector3.new(-1, 1, -1),
    Vector3.new(-1, -1, 1),
    Vector3.new(1, -1, 1),
    Vector3.new(1, 1, 1),
    Vector3.new(-1, 1, 1)
}

local EDGES = {
    {1,2},{2,3},{3,4},{4,1},
    {5,6},{6,7},{7,8},{8,5},
    {1,5},{2,6},{3,7},{4,8}
}

local latched = {}
local seen = {}
local lastFolderState = nil
local lastDebugPrint = 0

local function getCharacterData(player)
    if player == nil then
        return nil, nil, nil
    end

    local character = player.Character
    if character == nil then
        return nil, nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if humanoid == nil or root == nil then
        return nil, nil, nil
    end

    if humanoid.Health <= 0 then
        return nil, nil, nil
    end

    return character, humanoid, root
end

local function getLocalRoot()
    local character = LocalPlayer.Character
    if character == nil then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function makeLine()
    local line = Drawing.new("Line")
    line.Thickness = 3
    line.Transparency = 1
    line.Color = Color3.fromRGB(255, 40, 40)
    line.Visible = false
    line.ZIndex = 50
    return line
end

local function makeLabel()
    local label = Drawing.new("Text")
    label.Size = 16
    label.Center = true
    label.Outline = true
    label.Transparency = 1
    label.Color = Color3.fromRGB(255, 255, 255)
    label.Visible = false
    label.ZIndex = 51
    return label
end

local function hideLatch(data)
    if data == nil then
        return
    end

    local i = 1
    while i <= #data.Lines do
        data.Lines[i].Visible = false
        i = i + 1
    end

    data.Label.Visible = false
end

local function destroyLatch(player)
    local data = latched[player]
    if data == nil then
        return
    end

    local i = 1
    while i <= #data.Lines do
        local line = data.Lines[i]

        pcall(function()
            line:Remove()
        end)

        i = i + 1
    end

    pcall(function()
        data.Label:Remove()
    end)

    latched[player] = nil
end

local function clearAll()
    local list = {}

    for player, _ in pairs(latched) do
        list[#list + 1] = player
    end

    local i = 1
    while i <= #list do
        destroyLatch(list[i])
        i = i + 1
    end

    print("[StickyHitboxes V8] Cleared all sticky boxes")
end

local function findPlayerFromOwner(hitbox)
    local owner = hitbox:FindFirstChild("Owner")

    if owner == nil then
        return nil
    end

    if owner.ClassName ~= "StringValue" then
        return nil
    end

    local ownerName = owner.Value

    if ownerName == nil or ownerName == "" then
        return nil
    end

    local players = Players:GetPlayers()
    local i = 1

    while i <= #players do
        local player = players[i]

        if player ~= LocalPlayer then
            if player.Name == ownerName or player.DisplayName == ownerName then
                local character, humanoid, root = getCharacterData(player)

                if character ~= nil and humanoid ~= nil and root ~= nil then
                    return player
                end
            end
        end

        i = i + 1
    end

    return nil
end

local function nearestBodyPartDistance(character, hitboxPosition)
    local children = character:GetChildren()
    local bestDistance = math.huge
    local bestPart = nil

    local i = 1

    while i <= #children do
        local child = children[i]

        if child:IsA("BasePart") then
            local distance = (child.Position - hitboxPosition).Magnitude

            if distance < bestDistance then
                bestDistance = distance
                bestPart = child
            end
        end

        i = i + 1
    end

    return bestDistance, bestPart
end

local function findTarget(hitbox)
    local ownerPlayer = findPlayerFromOwner(hitbox)

    if ownerPlayer ~= nil then
        local ownerCharacter, ownerHumanoid, ownerRoot = getCharacterData(ownerPlayer)

        if ownerCharacter ~= nil then
            local _, ownerPart = nearestBodyPartDistance(ownerCharacter, hitbox.Position)

            print("[StickyHitboxes V8] Matched by Owner -> " .. tostring(ownerPlayer.Name))
            return ownerPlayer, ownerPart
        end

        return ownerPlayer, nil
    end

    local localRoot = getLocalRoot()

    if localRoot == nil then
        return nil
    end

    local players = Players:GetPlayers()
    local bestPlayer = nil
    local bestDistance = math.huge
    local bestPartName = "?"

    local i = 1

    while i <= #players do
        local player = players[i]

        if player ~= LocalPlayer then
            local character, humanoid, root = getCharacterData(player)

            if character ~= nil and humanoid ~= nil and root ~= nil then
                local distanceFromLocal = (root.Position - localRoot.Position).Magnitude

                if distanceFromLocal <= MAX_DISTANCE then
                    local bodyDistance, bodyPart = nearestBodyPartDistance(
                        character,
                        hitbox.Position
                    )

                    if bodyDistance < bestDistance then
                        bestDistance = bodyDistance
                        bestPlayer = player

                        if bodyPart ~= nil then
                            bestPartName = bodyPart.Name
                        end
                    end
                end
            end
        end

        i = i + 1
    end

    if bestPlayer ~= nil then
        local halfSize = hitbox.Size.Magnitude * 0.5
        local allowedDistance = MAX_MATCH_DISTANCE + halfSize

        if bestDistance <= allowedDistance then
            print(
                "[StickyHitboxes V8] Matched nearest -> "
                .. tostring(bestPlayer.Name)
                .. " | part="
                .. tostring(bestPartName)
                .. " | distance="
                .. tostring(math.floor(bestDistance * 100) / 100)
            )

            local bestCharacter = bestPlayer.Character
            local bestPart = nil

            if bestCharacter ~= nil then
                local _, matchedPart = nearestBodyPartDistance(
                    bestCharacter,
                    hitbox.Position
                )
                bestPart = matchedPart
            end

            return bestPlayer, bestPart
        end

        print(
            "[StickyHitboxes V8] Closest was "
            .. tostring(bestPlayer.Name)
            .. " at "
            .. tostring(math.floor(bestDistance * 100) / 100)
            .. " studs from hitbox"
        )
    end

    return nil, nil
end

local function latchPlayer(player, hitbox, matchedPart)
    local character, humanoid, root = getCharacterData(player)

    if character == nil or humanoid == nil or root == nil then
        return
    end

    -- Only the MOST RECENT detected hitbox for this player should exist.
    -- Destroy all drawings from the previous latch before creating the new one.
    destroyLatch(player)

    local targetPart = matchedPart

    if targetPart == nil or targetPart.Parent ~= character then
        targetPart = character:FindFirstChild("HumanoidRootPart")
    end

    if targetPart == nil then
        targetPart = character:FindFirstChild("UpperTorso")
    end

    if targetPart == nil then
        targetPart = character:FindFirstChild("Torso")
    end

    if targetPart == nil then
        return
    end

    local lines = {}
    local i = 1

    while i <= 12 do
        lines[i] = makeLine()
        i = i + 1
    end

    latched[player] = {
        Size = hitbox.Size,
        TargetPartName = targetPart.Name,
        Lines = lines,
        Label = makeLabel()
    }

    print(
        "[StickyHitboxes V8] LATCHED TO BODY -> "
        .. tostring(player.Name)
        .. " | part="
        .. tostring(targetPart.Name)
        .. " | size="
        .. tostring(hitbox.Size)
    )
end

local function getWorldCorners(center, size)
    local half = size * 0.5
    local result = {}

    local i = 1

    while i <= #CORNERS do
        local sign = CORNERS[i]

        result[i] = Vector3.new(
            center.X + sign.X * half.X,
            center.Y + sign.Y * half.Y,
            center.Z + sign.Z * half.Z
        )

        i = i + 1
    end

    return result
end

local function getBodyAnchor(character, root)
    local part = character:FindFirstChild("UpperTorso")

    if part == nil then
        part = character:FindFirstChild("Torso")
    end

    if part == nil then
        part = root
    end

    if part == nil then
        return nil
    end

    return part.Position, part
end

local function updateLatch(player, data)
    local character, humanoid, root = getCharacterData(player)

    if character == nil or humanoid == nil or root == nil then
        destroyLatch(player)
        return
    end

    local center, anchorPart = getBodyAnchor(character, root)

    if center == nil then
        destroyLatch(player)
        return
    end

    -- The detected hitbox supplies SIZE only.
    -- Position always follows the player's actual torso/root body part.
    local corners = getWorldCorners(center, data.Size)

    local screen = {}
    local i = 1

    while i <= #corners do
        local point, onScreen = WorldToScreen(corners[i])

        screen[i] = {
            Point = point,
            Visible = onScreen == true
        }

        i = i + 1
    end

    local visibleLines = 0
    i = 1

    while i <= #EDGES do
        local edge = EDGES[i]
        local a = screen[edge[1]]
        local b = screen[edge[2]]
        local line = data.Lines[i]

        local canDraw = false

        if a ~= nil and b ~= nil then
            if a.Point ~= nil and b.Point ~= nil then
                if a.Visible == true and b.Visible == true then
                    canDraw = true
                end
            end
        end

        if canDraw then
            line.From = a.Point
            line.To = b.Point
            line.Visible = true
            visibleLines = visibleLines + 1
        else
            line.Visible = false
        end

        i = i + 1
    end

    local labelHeight = data.Size.Y

    if anchorPart ~= nil and anchorPart.Size ~= nil then
        if anchorPart.Size.Y > labelHeight then
            labelHeight = anchorPart.Size.Y
        end
    end

    local topWorld = Vector3.new(
        center.X,
        center.Y + labelHeight * 0.5 + 0.8,
        center.Z
    )

    local labelPoint, labelVisible = WorldToScreen(topWorld)

    if labelPoint ~= nil and labelVisible == true then
        data.Label.Position = labelPoint
        data.Label.Text = tostring(player.DisplayName) .. " [HITBOX LOCKED]"
        data.Label.Visible = true
    else
        data.Label.Visible = false
    end

    if visibleLines == 0 then
        hideLatch(data)
    end
end

local function cleanup()
    local stale = {}

    for player, _ in pairs(latched) do
        local character, humanoid, root = getCharacterData(player)

        if player.Parent ~= Players then
            stale[#stale + 1] = player
        elseif character == nil or humanoid == nil or root == nil then
            stale[#stale + 1] = player
        end
    end

    local i = 1

    while i <= #stale do
        destroyLatch(stale[i])
        i = i + 1
    end
end

local function processHitboxes()
    local folder = Workspace:FindFirstChild("Hitboxes")

    if folder == nil then
        if lastFolderState ~= false then
            print("[StickyHitboxes V8] workspace.Hitboxes NOT FOUND")
            lastFolderState = false
        end

        return
    end

    if lastFolderState ~= true then
        print("[StickyHitboxes V8] workspace.Hitboxes FOUND")
        lastFolderState = true
    end

    local children = folder:GetChildren()
    local current = {}

    local i = 1

    while i <= #children do
        local hitbox = children[i]

        if hitbox:IsA("BasePart") then
            local key = hitbox.Address

            if key == nil then
                key = tostring(hitbox)
            end

            current[key] = true

            if seen[key] == nil then
                seen[key] = true

                print(
                    "[StickyHitboxes V8] New temporary hitbox | pos="
                    .. tostring(hitbox.Position)
                    .. " | size="
                    .. tostring(hitbox.Size)
                )

                local target, matchedPart = findTarget(hitbox)

                if target ~= nil then
                    latchPlayer(target, hitbox, matchedPart)
                end
            end
        end

        i = i + 1
    end

    local staleSeen = {}

    for key, _ in pairs(seen) do
        if current[key] == nil then
            staleSeen[#staleSeen + 1] = key
        end
    end

    i = 1

    while i <= #staleSeen do
        seen[staleSeen[i]] = nil
        i = i + 1
    end
end

task.spawn(function()
    while RUNNING do
        task.wait()

        if ENABLED then
            local ok, err = pcall(function()
                cleanup()
                processHitboxes()

                local players = {}

                for player, _ in pairs(latched) do
                    players[#players + 1] = player
                end

                local i = 1

                while i <= #players do
                    local player = players[i]
                    local data = latched[player]

                    if data ~= nil then
                        updateLatch(player, data)
                    end

                    i = i + 1
                end
            end)

            if not ok then
                warn("[StickyHitboxes V8] " .. tostring(err))
            end
        end
    end
end)

function StickyHitboxes.SetEnabled(value)
    ENABLED = value == true

    if ENABLED == false then
        clearAll()
    end
end

function StickyHitboxes.IsEnabled()
    return ENABLED
end

function StickyHitboxes.SetDetectionDistance(value)
    local numberValue = tonumber(value)

    if numberValue ~= nil and numberValue > 0 then
        MAX_DISTANCE = numberValue
        print("[StickyHitboxes V8] Detection range -> " .. tostring(MAX_DISTANCE))
    end
end

function StickyHitboxes.SetMatchDistance(value)
    local numberValue = tonumber(value)

    if numberValue ~= nil and numberValue > 0 then
        MAX_MATCH_DISTANCE = numberValue
    end
end

function StickyHitboxes.Clear()
    clearAll()
end

function StickyHitboxes.GetLatchedCount()
    local count = 0

    for _, _ in pairs(latched) do
        count = count + 1
    end

    return count
end

function StickyHitboxes.Destroy()
    ENABLED = false
    RUNNING = false
    clearAll()
end

print("[StickyHitboxes V8] MATCHA BODY-ANCHOR BUILD LOADED")
print("[StickyHitboxes V8] Detection range = 20 studs")
print("[StickyHitboxes V8] One newest box per player; follows torso/root")

return StickyHitboxes
