-- FFTM Fresh Player Hitboxes
-- Draws a 2D box + name/distance for every OTHER player within 20 studs.
-- Independent of workspace.Hitboxes and AttackName/Owner values.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local PlayerHitboxes = {}
PlayerHitboxes.__index = PlayerHitboxes

local MAX_DISTANCE = 20
local enabled = true
local trackers = {}

local function getCharacterParts(player)
    if not player then
        return nil
    end

    local character = player.Character
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not root then
        return nil
    end

    return character, humanoid, root
end

local function getLocalRoot()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function createTracker(player)
    local box = Drawing.new("Square")
    box.Filled = false
    box.Thickness = 2
    box.Transparency = 1
    box.Color = Color3.fromRGB(255, 80, 80)
    box.Visible = false
    box.ZIndex = 5

    local name = Drawing.new("Text")
    name.Size = 15
    name.Center = true
    name.Outline = true
    name.Transparency = 1
    name.Color = Color3.fromRGB(255, 255, 255)
    name.Visible = false
    name.ZIndex = 6

    local distance = Drawing.new("Text")
    distance.Size = 13
    distance.Center = true
    distance.Outline = true
    distance.Transparency = 1
    distance.Color = Color3.fromRGB(220, 220, 220)
    distance.Visible = false
    distance.ZIndex = 6

    trackers[player] = {
        Box = box,
        Name = name,
        Distance = distance,
    }

    return trackers[player]
end

local function hideTracker(tracker)
    if not tracker then
        return
    end

    tracker.Box.Visible = false
    tracker.Name.Visible = false
    tracker.Distance.Visible = false
end

local function destroyTracker(player)
    local tracker = trackers[player]
    if not tracker then
        return
    end

    pcall(function() tracker.Box:Remove() end)
    pcall(function() tracker.Name:Remove() end)
    pcall(function() tracker.Distance:Remove() end)

    trackers[player] = nil
end

local function getCharacterScreenBounds(character)
    local success, cf, size = pcall(function()
        return character:GetBoundingBox()
    end)

    if not success or not cf or not size then
        return nil
    end

    local half = size * 0.5

    local offsets = {
        Vector3.new(-half.X, -half.Y, -half.Z),
        Vector3.new( half.X, -half.Y, -half.Z),
        Vector3.new( half.X,  half.Y, -half.Z),
        Vector3.new(-half.X,  half.Y, -half.Z),
        Vector3.new(-half.X, -half.Y,  half.Z),
        Vector3.new( half.X, -half.Y,  half.Z),
        Vector3.new( half.X,  half.Y,  half.Z),
        Vector3.new(-half.X,  half.Y,  half.Z),
    }

    local minX = math.huge
    local minY = math.huge
    local maxX = -math.huge
    local maxY = -math.huge
    local visiblePoints = 0

    for _, offset in ipairs(offsets) do
        local worldPoint = cf:PointToWorldSpace(offset)
        local screenPoint, onScreen = WorldToScreen(worldPoint)

        if screenPoint and onScreen then
            visiblePoints += 1

            if screenPoint.X < minX then minX = screenPoint.X end
            if screenPoint.Y < minY then minY = screenPoint.Y end
            if screenPoint.X > maxX then maxX = screenPoint.X end
            if screenPoint.Y > maxY then maxY = screenPoint.Y end
        end
    end

    if visiblePoints < 2 then
        return nil
    end

    if minX == math.huge or minY == math.huge then
        return nil
    end

    return minX, minY, maxX, maxY
end

local function updatePlayer(player, localRoot)
    if player == LocalPlayer then
        return
    end

    local tracker = trackers[player] or createTracker(player)
    local character, humanoid, root = getCharacterParts(player)

    if not character or not humanoid or not root or not localRoot then
        hideTracker(tracker)
        return
    end

    local distance = (root.Position - localRoot.Position).Magnitude

    if distance > MAX_DISTANCE then
        hideTracker(tracker)
        return
    end

    local minX, minY, maxX, maxY = getCharacterScreenBounds(character)

    if not minX then
        hideTracker(tracker)
        return
    end

    local width = maxX - minX
    local height = maxY - minY

    if width <= 0 or height <= 0 then
        hideTracker(tracker)
        return
    end

    tracker.Box.Position = Vector2.new(minX, minY)
    tracker.Box.Size = Vector2.new(width, height)
    tracker.Box.Visible = true

    tracker.Name.Text = player.DisplayName or player.Name
    tracker.Name.Position = Vector2.new(
        minX + width / 2,
        minY - 18
    )
    tracker.Name.Visible = true

    tracker.Distance.Text = string.format("%.1f studs", distance)
    tracker.Distance.Position = Vector2.new(
        minX + width / 2,
        maxY + 2
    )
    tracker.Distance.Visible = true
end

local connection = RunService.RenderStepped:Connect(function()
    if not enabled then
        for _, tracker in pairs(trackers) do
            hideTracker(tracker)
        end
        return
    end

    local localRoot = getLocalRoot()

    for _, player in ipairs(Players:GetPlayers()) do
        updatePlayer(player, localRoot)
    end

    -- Remove trackers for players who left.
    for player in pairs(trackers) do
        if player.Parent ~= Players then
            destroyTracker(player)
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    destroyTracker(player)
end)

function PlayerHitboxes.SetEnabled(value)
    enabled = value == true

    if not enabled then
        for _, tracker in pairs(trackers) do
            hideTracker(tracker)
        end
    end
end

function PlayerHitboxes.IsEnabled()
    return enabled
end

function PlayerHitboxes.SetMaxDistance(value)
    value = tonumber(value)

    if value and value > 0 then
        MAX_DISTANCE = value
    end
end

function PlayerHitboxes.GetMaxDistance()
    return MAX_DISTANCE
end

function PlayerHitboxes.Clear()
    local playersToRemove = {}

    for player in pairs(trackers) do
        table.insert(playersToRemove, player)
    end

    for _, player in ipairs(playersToRemove) do
        destroyTracker(player)
    end
end

function PlayerHitboxes.Destroy()
    enabled = false

    if connection then
        connection:Disconnect()
        connection = nil
    end

    PlayerHitboxes.Clear()
end

print("[PlayerHitboxes] Loaded | range = " .. tostring(MAX_DISTANCE) .. " studs")

return PlayerHitboxes
